# ==================== AWS SNS CONFIGURATION ====================
# Required for OTP sending via SMS

# Get these from AWS IAM Console
# 1. Go to AWS IAM → Users → Create User
# 2. Attach policy: AmazonSNSFullAccess
# 3. Create access keys
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# AWS Region for SNS
# Use ap-south-1 (Mumbai) for India
AWS_REGION=ap-south-1

# Optional: Custom Sender ID (requires AWS approval for India)
# Without approval, SMS will show a random number
# With approval, SMS will show "ZSINDIA"
AWS_SNS_SENDER_ID=ZSINDIA

# ==================== EXISTING CONFIGURATION ====================
# Add the AWS variables above to your existing .env file
# Keep all your existing variables below
